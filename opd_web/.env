# Balaji Heart Center Frontend - Environment Configuration

# API Configuration
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_API_URL=http://localhost:8000

VITE_API_BASE_URL=https://opdbackend.vercel.app/api/v1
VITE_API_URL=https://opdbackend.vercel.app


# App Settings   
VITE_APP_NAME=Balaji Heart Center
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_DEBUG=true

# WhatsApp Mode: LOCAL | META
# LOCAL: Downloads PDF + opens wa.me for manual send (no API needed)
# META: Uses WhatsApp Business Cloud API via backend (production)
VITE_WHATSAPP_MODE=META

# Lab & Pharmacy Contact (for LOCAL WhatsApp mode)
VITE_LAB_PHONE=+919676328450
VITE_PHARMACY_PHONE=+919676328450

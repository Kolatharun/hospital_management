# Balaji Heart Center Backend - Environment Configuration

# Application
APP_NAME=Balaji Heart Center API
APP_VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:tiger@localhost:5432/balaji_heart_center
DATABASE_ECHO=False

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server
HOST=0.0.0.0
PORT=8000

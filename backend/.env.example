# ============================================
# Balaji Heart Center Backend - Environment Configuration
# ============================================
# Copy this file to .env and update values for your environment

# ============================================
# Application Settings
# ============================================
APP_NAME=Balaji Heart Center API
APP_VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api/v1

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/balaji_heart_center
DATABASE_ECHO=False

# ============================================
# JWT Authentication
# ============================================
# IMPORTANT: Change this secret key in production (minimum 32 characters)
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Security Settings
# ============================================
BCRYPT_ROUNDS=12

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8080

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000

# ============================================
# Email Configuration (SMTP)
# ============================================
# Used for sending bill receipts and notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true

# ============================================
# WhatsApp Business Cloud API
# ============================================
# Used for sending bill receipts via WhatsApp
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token

# ============================================
# Lab & Pharmacy Contact Details
# ============================================
LAB_EMAIL=lab@example.com
LAB_PHONE=+919876543210
PHARMACY_EMAIL=pharmacy@example.com
PHARMACY_PHONE=+919876543211

# ============================================
# Google Cloud Text-to-Speech
# ============================================
# Path to Google Cloud service account JSON key file
# Required for voice announcements on TV display
GOOGLE_APPLICATION_CREDENTIALS=./google-tts-key.json

# ============================================
# Balaji Heart Center - Frontend Environment
# ============================================
# Copy this file to .env and update values

# ============================================
# API Configuration
# ============================================
# Backend API base URL (without trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend API URL for direct API calls (TTS, etc.)
VITE_API_URL=http://localhost:8000

# ============================================
# App Settings
# ============================================
VITE_APP_NAME=Balaji Heart Center
VITE_APP_VERSION=1.0.0

# ============================================
# Feature Flags
# ============================================
# Enable debug mode (true/false)
VITE_ENABLE_DEBUG=false

# WhatsApp Mode: LOCAL | META
# LOCAL: Downloads PDF + opens wa.me for manual send (no API needed)
# META: Uses WhatsApp Business Cloud API via backend (production)
VITE_WHATSAPP_MODE=LOCAL

# Lab & Pharmacy Contact (for LOCAL WhatsApp mode)
VITE_LAB_PHONE=+919676328450
VITE_PHARMACY_PHONE=+919676328450
